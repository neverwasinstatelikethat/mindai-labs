          "legendFormat": "HTTP 429 · {{handler}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ёмкость: слоты приёма и LLM-семафор",
      "description": "mindai_agent_run_slots{state} и mindai_llm_slots{state} абсолютными значениями: active у limit — это порог, за которым начинаются 429, waiting у модели — очередь внутри чужого дедлайна.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 31
