FROM python:3.12-slim AS builder
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --prefix=/install .

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-eng tesseract-ocr-rus \
    && rm -rf /var/lib/apt/lists/*
RUN addgroup --system mindai && adduser --system --ingroup mindai mindai
WORKDIR /app
COPY --from=builder /install /usr/local
COPY src ./src
# Публичный корневой сертификат УЦ, к которому GigaChat прикладывает цепочку TLS:
# GIGACHAT_TRUSTED_ROOTS указывает на файл относительно рабочей директории /app.
COPY certs ./certs
USER mindai
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live')"
# Один воркер — контракт владения кэшем, а не экономия: снимок графа и кэш
# identical-output живут в процессе (`cache_scope: "process"` в /agents/metrics,
# серия mindai_process_info{pid}). N воркеров означают N холодных снимков (замер
# 4 октября: 1531 мс на потолке 600 узлов из 1501) и N копий RAM-каталога корпуса.
# Общего слоя для этих кэшей не подключено, поэтому менять число воркеров нужно
# вместе с ним, а не вместо него.
CMD ["uvicorn", "scientific_tangle.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
