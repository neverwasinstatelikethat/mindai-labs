APP_ENV=development
KNOWLEDGE_BACKEND=neo4j

# GigaChat — LLM-провайдер платформы.
# Резервной модели нет: без ключа сервис поднимается, но LLM-ответы недоступны.
GIGACHAT_API_KEY=
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AGENT_MODEL=GigaChat-3-Ultra
GIGACHAT_GRAPHRAG_MODEL=GigaChat-3-Pro
# GIGACHAT_API_PERS | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL_CERTS=true
# GigaChat отдаёт цепочку до Российского доверенного корневого УЦ (Минцифры), которого
# нет в certifi. Без этого корня аутентация падает на TLS-проверке; файл публичный.
GIGACHAT_TRUSTED_ROOTS=certs/russian-trusted-root-ca.crt
GIGACHAT_TIMEOUT_SECONDS=90
# Бюджет вывода одного обращения: без него JSON structured output режется
# дефолтом провайдера, и импорт падает на середине ответа модели
GIGACHAT_MAX_OUTPUT_TOKENS=16384
# Individual tier (GIGACHAT_API_PERS) — только 1 одновременный запрос
GIGACHAT_MAX_CONCURRENT=1
# Транспортные повторы SDK; поверх — не больше двух попыток schema-repair
GIGACHAT_MAX_RETRIES=3
# Открытые источники: без ключа public_search ищет аннотации Europe PMC.
# Для общего веб-поиска нужен ключ Tavily; передаётся только через окружение.
TAVILY_API_KEY=
# Размерность legacy-поля embedding в существующем Elasticsearch-индексе.
EMBEDDING_DIMENSIONS=1024
# Кэш structured output: один и тот же промпт (модель + схема + системный блок +
# контекст) не идёт в модель повторно. Ключ включает весь текст промпта, поэтому
# разные права доступа и история ветки в кэше не пересекаются. 0 — выключить кэш.
LLM_CACHE_TTL_SECONDS=900
LLM_CACHE_MAX_ENTRIES=256
# Потолок ожидания свободной модели в одном вызове: без него очередь молча
# съедает AGENT_DEADLINE_SECONDS, и «сервис занят» выглядит как «медленная модель».
GIGACHAT_QUEUE_WAIT_SECONDS=60
# Сколько не переэмбеддинговать один и тот же текст (0 — выключить).
EMBEDDING_CACHE_TTL_SECONDS=3600
# Пауза после терминального отказа на /embeddings (402, 401, 403): приговор
# аккаунту от числа запросов не меняется, а без паузы каждый новый текст вопроса
# платит round-trip и упирается в тот же отказ. 0 — выключить негативный кэш.
EMBEDDING_REFUSAL_COOLDOWN_SECONDS=30
# Токен для /metrics. Пусто — эндпоинт открыт (локальный контур); задано —
# Prometheus обязан присылать Authorization: Bearer, потому что метрики называют
# содержимое корпуса и режимы работы.
METRICS_TOKEN=

# Бюджет одного агентного запроса: при упоре в лимит возвращается неполный
# ответ с degradation_reasons, а не молчаливая обрезка
AGENT_DEADLINE_SECONDS=300
AGENT_MAX_TOOL_ROUNDS=2
AGENT_MAX_REVISIONS=1
# Потолок времени одного узла графа агента. Провайдер делит дедлайн запроса на
# попытки одного обращения, и без этого потолка один медленный узел выжигал бюджет
# целиком, не дав запуститься остальным узлам.
AGENT_NODE_BUDGET_SECONDS=120
# Бюджет доказательной части промпта reasoner/critic/improver. Это размер
# фактически включаемых доказательств, а не всё контекстное окно модели.
CONTEXT_TOKEN_BUDGET=12288
# Потолок candidate policy в системном промпте. Принятые правки EvolutionService
# растут вместе с числом предложений и без потолка вытесняют доказательства
# из окна модели.
POLICY_MAX_TOKENS=600
# Сколько агентных исследований идёт одновременно; следующий запрос получает 429.
AGENT_MAX_CONCURRENT_RUNS=4
# Явный потолок одновременных обращений к модели. Он перекрывает эвристику,
# когда оператор знает про тариф или несколько воркеров больше, чем видно из
# настроек процесса. Строка закомментирована намеренно: по умолчанию потолок
# считается минимумом из AGENT_MAX_CONCURRENT_RUNS и доступных слотов модели, а
# пустое значение в файле окружения дало бы полю int | None строку вместо «не
# задано».
#AGENT_ADMISSION_LIMIT=8
# Пул потоков для блокирующих чтений хранилища (Neo4j, Elasticsearch). Без него
# to_thread берёт default executor цикла, размер которого считается от ядер хоста:
# медленный обход графа занимает потоки, и список находок ждёт не хранилище, а поток.
STORAGE_THREAD_POOL_SIZE=16

# Доступ: серверная аутентификация вместо role-заголовков (docs/security-auth.md)
# memory — только тесты и запуск без базы: сессии не переживают перезапуск
ACCOUNTS_BACKEND=postgres
PASSWORD_MIN_LENGTH=10
SESSION_TTL_DAYS=14
# Неудачные входы на пару (email, client host) в пределах окна -> 429
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
# Хосты, которым разрешено присылать cookie-запросы (CSRF-проверка по Origin/Referer).
# Порты нестандартные сознательно: 3000/8000/9090 на рабочих машинах обычно заняты.
TRUSTED_ORIGINS=http://localhost:43119,http://127.0.0.1:43119,http://localhost:5173,http://localhost:46617,http://127.0.0.1:46617

CORS_ORIGINS=http://localhost:5173,http://localhost:43119
PUBLIC_API_URL=
BACKEND_PORT=46617
FRONTEND_PORT=43119
GRAFANA_PORT=45213
PROMETHEUS_PORT=46307
# Хранилища опубликованы только на 127.0.0.1 и портов из env не читают:
# Neo4j Browser 47129, bolt 44917, Elasticsearch 42733.

# Корпус документов (только для чтения) и предзагрузка
SOURCE_ROOT=/data/sources
PRELOAD_MODE=full
CORPUS_PRELOAD_LIMIT=900
CORPUS_MAX_FILE_BYTES=20971520

NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
# Пароль, который читает приложение (config.neo4j_password). Вне Docker Compose
# NEO4J_RUNTIME_PASSWORD приложение не видит: оно ждёт именно NEO4J_PASSWORD,
# иначе старт без compose даёт отказ Neo4j как 500 вместо внятной ошибки.
NEO4J_PASSWORD=mindai-neo4j-local
# Тот же пароль для compose-сервиса Neo4j и его healthcheck.
NEO4J_RUNTIME_PASSWORD=mindai-neo4j-local
ELASTICSEARCH_URL=http://elasticsearch:9200
# Redis в контуре = зарезервированное место под очереди задач: приложение его не
# вызывает (настройки в config нет), кэш structured output живёт в процессе.
# Ключ оставлен, чтобы старый локальный .env не требовал правки.
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://mindai:mindai-postgres-local@postgres:5432/mindai
POSTGRES_DB=mindai
POSTGRES_USER=mindai
POSTGRES_RUNTIME_PASSWORD=mindai-postgres-local

# Uploads разбираются в памяти и на диск не пишутся. Порты Neo4j, Elasticsearch,
# Prometheus и Grafana опубликованы только на 127.0.0.1 — наружу они не смотрят.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=mindai-grafana-local
