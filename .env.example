APP_ENV=development
MODEL_MODE=auto
KNOWLEDGE_BACKEND=neo4j
YANDEX_API_KEY=
FOLDER_ID=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_MODEL_ID=yandexgpt
YANDEX_MODEL_VERSION=latest
YANDEX_MODEL_URI=
YANDEX_TIMEOUT_SECONDS=90

# GigaChat fallback LLM
GIGACHAT_API_KEY=
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL_CERTS=false

YANDEX_EMBEDDINGS_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/textEmbedding
EMBEDDING_DIMENSIONS=256
CORS_ORIGINS=http://localhost:5173,http://localhost:13000
PUBLIC_API_URL=
BACKEND_PORT=18000
FRONTEND_PORT=13000
GRAFANA_PORT=13001
PROMETHEUS_PORT=19090

NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_RUNTIME_PASSWORD=mindai-neo4j-local
ELASTICSEARCH_URL=http://elasticsearch:9200
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://mindai:mindai-postgres-local@postgres:5432/mindai
POSTGRES_DB=mindai
POSTGRES_USER=mindai
POSTGRES_RUNTIME_PASSWORD=mindai-postgres-local

S3_ENDPOINT_URL=http://minio:9000
MINIO_ROOT_USER=mindai
MINIO_ROOT_PASSWORD=mindai-local-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=mindai-grafana-local
